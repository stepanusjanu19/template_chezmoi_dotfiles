#path function load => alternatives python
function set_python() {
    local version="$1"
    if [ -z "$version" ]; then
        echo "Usage: set_python <version>"
        echo "Example: set_python 3.14"
        return 1
    fi
    python_path=$(which python$version)
    if [ -z "$python_path" ]; then
        echo "Python $version is not installed. Installing..."
        sudo dnf install -y python$version
        python_path=$(which python$version)
        if [ -z "$python_path" ]; then
            echo "Error: Failed to install Python $version. Please check your installation."
            return 1
        fi
        echo "Python $version installed successfully."
    else
        echo "Python $version is already installed."
    fi
    alternative_path=$(sudo alternatives --display python3 2>/dev/null | grep "$python_path" | awk '{print $1}')
    if [ -z "$alternative_path" ]; then
        echo "Registering Python $version with alternatives..."
        sudo alternatives --install /usr/bin/python3 python3 $python_path 1
    else
        echo "Python $version is already registered with alternatives."
    fi
    echo "Switching to Python $version..."
    sudo alternatives --config python3
}


py() {
    local version="$1"

    if [[ -z "$version" ]]; then
        echo "Usage: set_python <version>"
        echo "Example: set_python 3.14"
        return 1
    fi

    local pybin="/usr/bin/python${version}"

    if [[ ! -x "$pybin" ]]; then
        echo "Python ${version} not found. Install it with:"
        echo "  sudo dnf install python${version}"
        return 1
    fi

    # Shell-only overrides (SAFE)
    alias python="$pybin"
    alias python3="$pybin"
    alias pip="$pybin -m pip"

    export PYTHON_VERSION_ACTIVE="$version"

    echo "✅ Switched shell to Python ${version}"
    python --version
    pip --version
}

